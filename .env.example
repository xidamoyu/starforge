# ============================================================
# StarForge 环境配置示例
# 复制为 .env 后填入真实值（.env 不要提交到版本库）
# ============================================================

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=starforge
PGUSER=postgres
PGPASSWORD=你的密码

# --- 主模型（意图识别 / 需求解析 / 理由生成）---
# 走 DashScope（OpenAI 兼容接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=qwen-plus

# --- Embedding（本地 Ollama）---
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# --- 向量库 ---
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=starforge_creators

# --- Rerank（V1 暂不启用）---
RERANK_ENABLED=false
